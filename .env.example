APP_MODE=demo
HOST=127.0.0.1
PORT=4310
# New workspace: confirmed use-case names, no invented project records.
SEED_PROFILE=portfolio
# Optional override. Defaults: portfolio=.data/portfolio, demo=.data/pmo,
# project=.data/client, showcase=.data/showcase.
# DATA_DIR=.data/portfolio
# Set DATABASE_URL to use standard PostgreSQL instead of local PGlite.
# DATABASE_URL=postgresql://user:password@localhost:5432/pmo
# AI features are optional. Set a key only for an approved data processing environment.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
